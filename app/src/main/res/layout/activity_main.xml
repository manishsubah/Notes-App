<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ground"
    tools:context=".presentation.ui.MainActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/screen"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Navy band: runs under the status bar and ends partway down the pass. -->
        <View
            android:id="@+id/band"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@color/band"
            app:layout_constraintBottom_toTopOf="@id/band_end"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="12dp"
            android:accessibilityHeading="true"
            android:text="@string/app_title"
            android:textAppearance="@style/TextAppearance.NotesApp.Title"
            app:layout_constraintEnd_toStartOf="@id/count"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:textAppearance="@style/TextAppearance.NotesApp.Label"
            android:textColor="@color/on_band_muted"
            app:layout_constraintBaseline_toBaselineOf="@id/title"
            app:layout_constraintEnd_toStartOf="@id/theme_button"
            tools:text="7 open · 1 done" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/theme_button"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:layout_marginEnd="8dp"
            android:contentDescription="@string/theme_title"
            app:icon="@drawable/ic_contrast"
            app:iconTint="@color/on_band_muted"
            app:layout_constraintBottom_toBottomOf="@id/title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/title"
            app:rippleColor="@color/on_band_muted" />

        <!-- The boarding pass: the composer. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/pass"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/spacing_md"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="@color/panel"
            app:cardCornerRadius="@dimen/corner_panel"
            app:cardElevation="@dimen/pass_elevation"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/title"
            app:strokeColor="@color/pass_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/pass_main"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/spacing_md"
                    android:paddingTop="12dp"
                    android:paddingEnd="@dimen/spacing_sm"
                    android:paddingBottom="@dimen/spacing_md">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="24dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/pass_label"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/pass_label_new"
                            android:textAppearance="@style/TextAppearance.NotesApp.Label" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/pass_cancel"
                            style="@style/Widget.NotesApp.TextAction"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/pass_cancel"
                            android:visibility="gone"
                            tools:visibility="visible" />
                    </LinearLayout>

                    <EditText
                        android:id="@+id/input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:background="@null"
                        android:hint="@string/pass_hint"
                        android:importantForAutofill="no"
                        android:imeOptions="actionDone"
                        android:inputType="textCapSentences|textMultiLine"
                        android:maxLines="5"
                        android:minHeight="@dimen/touch_target"
                        android:paddingVertical="8dp"
                        android:textAppearance="@style/TextAppearance.NotesApp.Note"
                        android:textColorHint="@color/label"
                        android:textCursorDrawable="@null"
                        android:textSize="18sp" />
                </LinearLayout>

                <com.notes.manishsubah.presentation.ui.PerforationView
                    android:layout_width="@dimen/pass_notch"
                    android:layout_height="match_parent" />

                <FrameLayout
                    android:id="@+id/stub"
                    android:layout_width="@dimen/pass_stub_width"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_stub"
                    android:clickable="true"
                    android:contentDescription="@string/add_note"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/stub_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:text="@string/pass_stub_add"
                        android:textAppearance="@style/TextAppearance.NotesApp.Stub" />
                </FrameLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <Space
            android:id="@+id/band_end"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/pass_overlap"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/pass" />

        <!-- The board: fixed column header, scrolling rows. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/board"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginHorizontal="@dimen/spacing_md"
            android:layout_marginTop="@dimen/spacing_md"
            android:layout_marginBottom="@dimen/spacing_md"
            app:cardBackgroundColor="@color/panel"
            app:cardCornerRadius="@dimen/corner_panel"
            app:cardElevation="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/pass"
            app:strokeColor="@color/hairline"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/columns"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:gravity="center_vertical"
                    android:importantForAccessibility="noHideDescendants"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp">

                    <TextView
                        android:layout_width="@dimen/board_time_column"
                        android:layout_height="wrap_content"
                        android:text="@string/column_time"
                        android:textAppearance="@style/TextAppearance.NotesApp.Label" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_sm"
                        android:layout_weight="1"
                        android:text="@string/column_note"
                        android:textAppearance="@style/TextAppearance.NotesApp.Label" />

                    <TextView
                        android:layout_width="@dimen/board_status_column"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:text="@string/column_status"
                        android:textAppearance="@style/TextAppearance.NotesApp.Label" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/hairline" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerview"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToPadding="false"
                        android:paddingBottom="@dimen/spacing_sm"
                        tools:listitem="@layout/item_note" />

                    <LinearLayout
                        android:id="@+id/empty_state"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <!-- An empty departure board: the grid is there, waiting for its first entry. -->
                        <include layout="@layout/item_ghost_row" />
                        <include layout="@layout/item_ghost_row" />
                        <include layout="@layout/item_ghost_row" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingHorizontal="@dimen/spacing_lg">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:accessibilityHeading="true"
                                android:text="@string/empty_title"
                                android:textAppearance="@style/TextAppearance.NotesApp.Label"
                                android:textColor="@color/ink"
                                android:textSize="15sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_xs"
                                android:gravity="center"
                                android:text="@string/empty_subtitle"
                                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                                android:textColor="@color/label" />

                            <!-- Gesture legend, set like a board's key. -->
                            <TableLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_lg"
                                android:background="@drawable/bg_tag_blank"
                                android:paddingHorizontal="@dimen/spacing_md"
                                android:paddingVertical="12dp"
                                android:shrinkColumns="1">

                                <TableRow android:paddingVertical="4dp">
                                    <TextView
                                        android:text="@string/legend_tap"
                                        android:textAppearance="@style/TextAppearance.NotesApp.Label"
                                        android:textColor="@color/ink" />
                                    <TextView
                                        android:layout_marginStart="@dimen/spacing_md"
                                        android:text="@string/legend_tap_action"
                                        android:textAppearance="@style/TextAppearance.NotesApp.Label" />
                                </TableRow>

                                <TableRow android:paddingVertical="4dp">
                                    <TextView
                                        android:text="@string/legend_swipe_start"
                                        android:textAppearance="@style/TextAppearance.NotesApp.Label"
                                        android:textColor="@color/ink" />
                                    <TextView
                                        android:layout_marginStart="@dimen/spacing_md"
                                        android:text="@string/legend_swipe_start_action"
                                        android:textAppearance="@style/TextAppearance.NotesApp.Label" />
                                </TableRow>

                                <TableRow android:paddingVertical="4dp">
                                    <TextView
                                        android:text="@string/legend_swipe_end"
                                        android:textAppearance="@style/TextAppearance.NotesApp.Label"
                                        android:textColor="@color/ink" />
                                    <TextView
                                        android:layout_marginStart="@dimen/spacing_md"
                                        android:text="@string/legend_swipe_end_action"
                                        android:textAppearance="@style/TextAppearance.NotesApp.Label" />
                                </TableRow>
                            </TableLayout>
                        </LinearLayout>
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
